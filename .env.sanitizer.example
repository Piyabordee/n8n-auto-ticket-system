# ============================================
# n8n Workflow Sanitizer - Configuration Template
# ============================================
#
# วิธีใช้งาน:
# 1. Copy ไฟล์นี้เป็น .env.sanitizer
# 2. กรอกข้อมูลจริงของคุณลงใน SANITIZE_XXX
# 3. (ไม่บังคับ) ระบุ PLACEHOLDER_XXX ถ้าต้องการ custom
#
# รูปแบบ:
#   SANITIZE_ชื่อ=ค่าจริงที่ต้องการซ่อน
#   PLACEHOLDER_ชื่อ=ค่าที่ต้องการแทนที่
#
# ตัวอย่าง:
#   SANITIZE_DB_NAME=ProductionDB
#   PLACEHOLDER_DB_NAME=YourDatabase
#   ผลลัพธ์: ProductionDB -> YourDatabase
#
# ⚠️ ถ้าไม่ระบุ PLACEHOLDER_XXX จะใช้ค่า default อัตโนมัติ:
#   - Database -> YourDatabase
#   - Table -> YourTable
#   - URL -> example.com
#   - Email -> user@example.com
#   - Name -> YourName
#   - Key/Token -> YourKey
# ============================================

# ============================================
# 🗄️ DATABASE (ฐานข้อมูล)
# ============================================
# ชื่อฐานข้อมูลจริง
SANITIZE_DB_NAME=YourRealDatabaseName
PLACEHOLDER_DB_NAME=YourDatabase

# ชื่อตาราง
SANITIZE_DB_TABLE=your_table_name
PLACEHOLDER_DB_TABLE=YourTable

# ชื่อตาราง log
SANITIZE_DB_LOG_TABLE=your_log_table_name
PLACEHOLDER_DB_LOG_TABLE=YourLogTable

# ============================================
# 🌐 URLs (เว็บไซต์)
# ============================================
# Domain หลักของบริษัท
SANITIZE_URL_DOMAIN=yourcompany.com
PLACEHOLDER_URL_DOMAIN=example.com

# n8n server
SANITIZE_URL_N8N=n8n.yourcompany.com
PLACEHOLDER_URL_N8N=n8n.example.com

# เว็บอื่นๆ
SANITIZE_URL_ELEARNING=e-learning.yourcompany.com
PLACEHOLDER_URL_ELEARNING=e-learning.example.com

# ============================================
# 📧 EMAILS (อีเมล)
# ============================================
# อีเมล helpdesk/support
SANITIZE_EMAIL_HELPDESK=helpdesk@yourcompany.com
PLACEHOLDER_EMAIL_HELPDESK=helpdesk@example.com

# ============================================
# 🏢 COMPANY NAMES (ชื่อบริษัท/หน่วยงาน)
# ============================================
# ชื่อหน่วยงาน/สาขา (ใช้ชื่อจริงของคุณ)
SANITIZE_BRANCH_OFFICE=Your Branch Office
PLACEHOLDER_BRANCH_OFFICE=YourBranch

SANITIZE_BRANCH_MAIN=Head Office
PLACEHOLDER_BRANCH_MAIN=Headquarters

# ชื่อบริษัท
SANITIZE_COMPANY_NAME=YourCompanyName
PLACEHOLDER_COMPANY_NAME=[Company Name]

# ชื่อบริษัทแบบเต็ม
SANITIZE_COMPANY_FULL=Your Company Full Name Limited
PLACEHOLDER_COMPANY_FULL=[Company Name]

# ============================================
# 🔑 CREDENTIALS (คีย์/โทเคน/รหัส - ถ้าต้องการซ่อน)
# ============================================
# ระบุ credential IDs ของ n8n ที่ต้องการซ่อน
# SANITIZE_CREDENTIAL_API=your_api_credential_id
# PLACEHOLDER_CREDENTIAL_API=YOUR_API_CREDENTIAL_ID
#
# SANITIZE_CREDENTIAL_DB=your_db_credential_id
# PLACEHOLDER_CREDENTIAL_DB=YOUR_DB_CREDENTIAL_ID

# ============================================
# 🏷️ ABBREVIATIONS (ตัวย่/คำย่)
# ============================================
# ตัวย่ที่ต้องการเปลี่ยน
# SANITIZE_ABBR_HQ=HQ
# PLACEHOLDER_ABBR_HQ=Headquarters
#
# SANITIZE_ABBR_INC=Inc
# PLACEHOLDER_ABBR_INC=Company

# ============================================
# ➕ ADD YOUR OWN (เพิ่มเองได้ที่นี่)
# ============================================
# เพียงแค่เพิ่มคู่ SANITIZE_/PLACEHOLDER_ ตามรูปแบบ:
#
# SANITIZE_YOUR_CUSTOM_NAME=RealValue
# PLACEHOLDER_YOUR_CUSTOM_NAME=PlaceholderValue
