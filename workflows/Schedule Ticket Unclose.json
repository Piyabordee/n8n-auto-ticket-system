        "text": "={{\n  \"🔔 สรุปรายการ Ticket ตกค้าง ทั้งหมด \" + $json.data.length + \" รายการ\\n\" +\n  \"==================================================\\n\\n\" +\n  $json.data.map((i, index) => {\n    \n    const dateObj = new Date(i.created_date);\n    const date = DateTime.fromJSDate(dateObj).setZone('Asia/Bangkok').toFormat('dd/MM/yyyy HH:mm');\n    const detail = i.clean_text.match(/ปัญหา\\s*\\s*([\\s\\S]*)/)?.[1]?.trim() || i.clean_text;\n    \n    return `${index + 1}. ${i.subject}\n    🏢 สาขา: ${i.branch_name} (${i.branch_company})\n    🙋🏻 ผู้แจ้ง: ${i.created_by}\n    👨🏻‍🔧 IT ผู้ดูแล: ${i.assigned_to}\n    📅 แจ้งเมื่อ: ${date}\n    📝 รายละเอียด: ${detail}`;\n  }).join('\\n\\n--------------------------------------------------\\n\\n')\n}}\n\n==================================================\n\n\n",
