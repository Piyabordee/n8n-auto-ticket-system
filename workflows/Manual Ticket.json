    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE [YourDatabase].[dbo].[ticket]\nSET status = 'closed',\n    close_cause = N'{{ $('On form submission').item.json.close_cause }}',\n    close_reason = N'{{ $('On form submission').item.json.close_reason }}',\n    updated_date = GETDATE(),\n    updated_by = N'{{ $('Match IT Team').item.json?.userId || 'manual-ticket' }}',\n    close_time_minute = CASE \n    WHEN DATEDIFF(MINUTE, created_date, GETDATE()) - 1 < 0 THEN 0 \n    ELSE DATEDIFF(MINUTE, created_date, GETDATE()) - 1 \nEND\nWHERE message_id = N'{{ $('On form submission').item.json.messageId }}';",
        "options": {}
      },
